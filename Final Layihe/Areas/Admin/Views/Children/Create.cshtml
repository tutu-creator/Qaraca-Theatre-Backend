@model Final_Layihe.Models.Children

@{
    ViewData["Title"] = "Yeni Tamaşa";
}

<style>
    body {
        background-color: #8b2e2e !important;
        color: #f5f5f5 !important;
    }
    .tw-wrapper { display: flex; flex-direction: column; align-items: center; padding: 2rem 5%; }
    .tw-header { display: flex; align-items: center; gap: 14px; margin-bottom: 2rem; width: 100%; max-width: 680px; }
    .tw-icon { width: 48px; height: 48px; border-radius: 8px; background: linear-gradient(45deg, #d90429, #ff9f1c); display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .tw-title { font-family: 'Playfair Display', serif; font-size: 22px; font-weight: 700; color: #ff9f1c; margin: 0; letter-spacing: 1px; }
    .tw-sub { font-size: 12px; color: #aaa; margin: 2px 0 0; text-transform: uppercase; letter-spacing: 0.06em; }
    .tw-card { background: #1a1a1a; border-radius: 10px; border-top: 3px solid #d90429; padding: 1.75rem; width: 100%; max-width: 680px; }
    .tw-sec-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #f5f5f5; margin: 0 0 1.25rem; padding-bottom: 0.6rem; border-bottom: 1px solid #a03535; }
    .tw-field { margin-bottom: 1.25rem; }
    .tw-label { display: block; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: #f5f5f5; margin-bottom: 7px; }
    .tw-input { width: 100%; box-sizing: border-box; padding: 11px 14px; font-size: 14px; font-family: 'Open Sans', sans-serif; background: #1a1a1a; border: 1px solid #a03535; border-radius: 5px; color: #f5f5f5; outline: none; transition: border-color 0.2s, box-shadow 0.2s; }
    .tw-input:focus { border-color: #ff9f1c; box-shadow: 0 0 0 3px rgba(255,159,28,0.12); }
    .tw-hint { font-size: 11px; color: #ddd; margin-top: 4px; }
    .tw-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1rem; }
    .tw-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #a03535; }
    .tw-btn { padding: 0.75rem 2rem; background: linear-gradient(45deg, #d90429, #ff9f1c); color: #fff; border: none; border-radius: 30px; font-size: 14px; font-weight: 600; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
    .tw-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255,159,28,0.35); }
    .tw-back { font-size: 13px; color: #f5f5f5; text-decoration: none; transition: color 0.2s; }
    .tw-back:hover { color: #ff9f1c; }
</style>

<div class="tw-wrapper">
    <div class="tw-header">
        <div class="tw-icon">🎭</div>
        <div>
            <p class="tw-title">Yeni Tamaşa</p>
            <p class="tw-sub">Uşaq tamaşaları · Admin Panel</p>
        </div>
    </div>

    <div class="tw-card">
        <p class="tw-sec-label">Tamaşa məlumatları</p>

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="tw-field">
                <label asp-for="Name" class="tw-label"></label>
                <input asp-for="Name" class="tw-input" placeholder="Tamaşanın adını daxil edin" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="tw-field">
                <label asp-for="Description" class="tw-label"></label>
                <textarea asp-for="Description" class="tw-input" rows="4" placeholder="Tamaşa haqqında qısa məlumat..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="tw-grid">
                <div class="tw-field">
                    <label asp-for="Image" class="tw-label"></label>
                    <input asp-for="Image" class="tw-input" placeholder="https://..." />
                    <p class="tw-hint">Afişa şəklinin linki</p>
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>
                <div class="tw-field">
                    <label asp-for="Price" class="tw-label"></label>
                    <input asp-for="Price" class="tw-input" placeholder="0.00" />
                    <p class="tw-hint">AZN ilə</p>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="tw-actions">
                <a asp-action="Index" class="tw-back">← Siyahıya qayıt</a>
                <input type="submit" value="Yadda saxla" class="tw-btn" />
            </div>
        </form>
    </div>
</div>