@model IEnumerable<Final_Layihe.Models.Children>

@{
    ViewData["Title"] = "Uşaq Tamaşaları";
}

<style>
    body {
        background-color: #8b2e2e !important;
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 5vh 0;
    }

    .admin-wrapper {
        width: 100%;
        max-width: 1100px;
        padding: 2rem 1.5rem;
    }

    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.5);
    }

    .admin-header h1 {
        font-family: "Playfair Display", serif;
        font-size: 2rem;
        color: #ff9f1c;
    }

    .btn-create {
        display: inline-block;
        padding: 0.7rem 1.6rem;
        background: linear-gradient(45deg, #d90429, #ff9f1c);
        color: #fff;
        text-decoration: none;
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(255, 159, 28, 0.4);
        color: #fff;
        text-decoration: none;
    }

    .table-card {
        background: #111;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid rgba(217, 4, 41, 0.25);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.5);
    }

    .admin-table {
        width: 100%;
        border-collapse: collapse;
    }

    .admin-table thead {
        background: linear-gradient(90deg, #1a0005, #1a0a00);
        border-bottom: 2px solid #d90429;
    }

    .admin-table thead th {
        padding: 1rem 1.5rem;
        text-align: left;
        font-family: "Playfair Display", serif;
        font-size: 0.9rem;
        color: #ff9f1c;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .admin-table tbody tr {
        border-bottom: 1px solid rgba(255,255,255,0.05);
        transition: background 0.2s ease;
    }

    .admin-table tbody tr:last-child {
        border-bottom: none;
    }

    .admin-table tbody tr:hover {
        background: rgba(217, 4, 41, 0.07);
    }

    .admin-table tbody td {
        padding: 1rem 1.5rem;
        color: #ccc;
        font-size: 0.93rem;
        vertical-align: middle;
    }

    .price-cell {
        color: #ff9f1c !important;
        font-weight: 600;
        font-family: "Playfair Display", serif;
    }

    .image-cell {
        color: #666 !important;
        font-style: italic;
        font-size: 0.85rem !important;
    }

    .action-cell {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .btn-action {
        padding: 0.35rem 0.9rem;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.25s ease;
        display: inline-block;
    }

    .btn-edit {
        color: #ff9f1c;
        border: 1px solid #ff9f1c;
    }

    .btn-edit:hover {
        background: #ff9f1c;
        color: #0d0d0d;
        text-decoration: none;
    }

    .btn-details {
        color: #aaa;
        border: 1px solid #444;
    }

    .btn-details:hover {
        background: #333;
        color: #fff;
        text-decoration: none;
    }

    .btn-delete {
        color: #d90429;
        border: 1px solid #d90429;
    }

    .btn-delete:hover {
        background: #d90429;
        color: #fff;
        text-decoration: none;
    }
</style>

<div class="admin-wrapper">

    <div class="admin-header">
        <h1>🎭 Uşaq Tamaşaları</h1>
        <a asp-action="Create" class="btn-create">+ Yeni Əlavə Et</a>
    </div>

    <div class="table-card">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Description)</th>
                    <th>@Html.DisplayNameFor(model => model.Image)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                    <th>Əməliyyatlar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                        <td class="image-cell">@Html.DisplayFor(modelItem => item.Image)</td>
                        <td class="price-cell">@Html.DisplayFor(modelItem => item.Price)</td>
                        <td>
                            <div class="action-cell">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-edit">Düzəliş</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-details">Detallar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-delete">Sil</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>