

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}



<div
      class="page-hero"
      style="
        background-image:
          linear-gradient(rgba(13, 13, 13, 0.8), rgba(13, 13, 13, 0.9)),
          url(images/sehne_arxasi_1776926159386.png);
      "
    >
      <h1>Biz Kimik?</h1>
      <p>"Qaraca" teatrının hekayəsi</p>
    </div>

    <!-- Məqsədimiz və Rəhbərlik (2 Col Layout) -->
    <section class="section-padding">
      <div class="two-col-layout" style="max-width: 1000px; margin: 0 auto">
        <div
          class="two-col-img"
          style="
            background-image: url(images/qirmizixett.png);
          "
        ></div>
        <div class="two-col-text">
          <h2 class="section-title" style="text-align: left; font-size: 2rem">
            Qaranlıqdan Doğan İşıq
          </h2>
          <p
            style="
              color: #ccc;
              font-size: 1.1rem;
              line-height: 1.8;
              margin-bottom: 1.5rem;
            "
          >
            2020-ci ildə bir neçə gənc və ehtiraslı aktyor tərəfindən yaradılan
            "Qaraca" Teatrı, sənətin ən təbii formasını tamaşaçılara çatdırmaq
            məqsədi güdür. Biz ənənəvi teatr çərçivələrindən çıxaraq, insan
            hisslərinin daha dərin qatlarına toxunuruq.
          </p>
          <p style="color: #ccc; font-size: 1.1rem; line-height: 1.8">
            Səhnəmizdə dekorasiyadan çox duyğulara yer verilir. Qara rəng bizim
            üçün sadəcə bir fon deyil, bütün rəngləri və hekayələri özündə
            birləşdirən bütövlükdür. Bunun içində yanan qırmızı və narıncı
            tonlar isə həyat işığımızdır.
          </p>
        </div>
      </div>
    </section>

    <section class="section-padding dark-bg text-center">
      <div style="max-width: 800px; margin: 0 auto">
        <h2 class="section-title">Missiyamız</h2>
        <p style="font-size: 1.2rem; color: #bbb; line-height: 1.8">
          Bizim missiyamız teatrı sadəcə izlənilən bir sənət növü olmaqdan
          çıxarıb, tamamilə yaşanılan və bir-bir hiss edilən ruhi təcrübəyə
          çevirməkdir. Gələn hər kəs səhnədə yalnız aktyorları deyil, öz real
          hekayəsindən və ruhundan bir parçanı görməlidir.
        </p>
      </div>
    </section>

    <!-- NEW SECTION: BƏDİİ RƏHBƏR -->
    <section class="section-padding">
      <div class="two-col-layout" style="max-width: 1000px; margin: 0 auto">
        <div class="two-col-text">
          <h2
            class="section-title"
            style="
              text-align: left;
              font-size: 2rem;
              color: var(--primary-orange);
            "
          >
            Bədii Rəhbər
          </h2>
          <h3
            style="
              font-family: var(--font-heading);
              font-size: 1.5rem;
              margin-bottom: 1rem;
            "
          >
            Tutu Qaraca
          </h3>
          <p
            style="
              color: #ccc;
              font-size: 1.1rem;
              line-height: 1.8;
              margin-bottom: 1.5rem;
            "
          >
            "Teatr insanı oyatmalıdır. Səhnə, insanların gündəlik həyatlarında
            qaçdıqları gerçəklərlə üzləşdiyi yer olmalıdır." - bu prinsip, Nicat
            bəyin illərdir teatr sahəsində tətbiq etdiyi əsas yanaşmadır.
          </p>
          <p style="color: #ccc; font-size: 1.1rem; line-height: 1.8">
            Avropada müxtəlif beynəlxalq dərəcəli dram dərsləri aldıqdan sonra
            o, vətənə qayıdaraq Qaraca teatrını qurdu. Onun yenilikçi və bəzən
            radikal səhnə quruluşu artıq yerli tamaşaçıların favoritinə
            çevrilib.
          </p>
        </div>
        <!-- LOCAL IMAGE FOR DIRECTOR -->
        <div
          class="two-col-img"
          style="
            background-image: url(images/ChatGPTImage.png);
            border-radius: 50%;
            width: 300px;
            height: 300px;
            flex: none;
          "
        ></div>
      </div>
    </section>

    <!-- TIMELINE -->
    <section class="section-padding dark-bg">
      <h2 class="section-title">Tariximiz Qısaca</h2>
      <div class="timeline">
        <div class="timeline-item">
          <h4
            style="
              color: var(--primary-orange);
              font-size: 1.2rem;
              margin-bottom: 5px;
            "
          >
            2020 - Quruluş
          </h4>
          <p style="color: #bbb">
            Gənc qrup tərəfindən "Qaraca"nın ilk təməlləri kiçik bir zirzəmi
            otağında atıldı.
          </p>
        </div>
        <div class="timeline-item">
          <h4
            style="
              color: var(--primary-orange);
              font-size: 1.2rem;
              margin-bottom: 5px;
            "
          >
            2022 - İlk Böyük Səhnə
          </h4>
          <p style="color: #bbb">
            "Qırmızı Xətt" tamaşası ilə paytaxtın böyük səhnələrindən birinə
            çıxış əldə etdik.
          </p>
        </div>
        <div class="timeline-item">
          <h4
            style="
              color: var(--primary-orange);
              font-size: 1.2rem;
              margin-bottom: 5px;
            "
          >
            2024 - Mütəmadi Repertuar
          </h4>
          <p style="color: #bbb">
            Tam təchizatlı öz binamıza köçdük və həftəlik nümayişlərə başladıq.
          </p>
        </div>
        <div class="timeline-item">
          <h4
            style="
              color: var(--primary-orange);
              font-size: 1.2rem;
              margin-bottom: 5px;
            "
          >
            2026 - Beynəlxalq Arena
          </h4>
          <p style="color: #bbb">
            Teatrımız ilk dəfə Avropa teatr festivalında Azərbaycanı layiqincə
            təmsil etdi.
          </p>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="section-padding">
      <h2 class="section-title">Statistikamız</h2>
      <div
        class="stats-row"
        style="max-width: 1000px; margin: 0 auto; background: transparent"
      >
        <div class="stat-item">
          <div class="stat-number">6+</div>
          <div class="stat-title">Fəaliyyət İlı</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">40+</div>
          <div class="stat-title">Müxtəlif Tamaşa</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">10K+</div>
          <div class="stat-title">Məmnun İzləyici</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">15+</div>
          <div class="stat-title">Mükafat</div>
        </div>
      </div>
    </section>