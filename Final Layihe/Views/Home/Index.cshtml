    <h2 class="section-title">Günün Tamaşaları</h2>
    <div class="play-grid" style="max-width: 1200px; margin: 0 auto">
      <div class="play-card">
        <div class="card-image" style="background: linear-gradient(to top, rgba(13, 13, 13, 0.9), transparent), url(images/qirmizixett.png) center/cover;"></div>
        <div class="card-content">
          <h3>Qırmızı Xətt</h3>
          <p>Dram | 120 dəq</p>
          <button class="outline-btn" onclick="openPopup('Qırmızı Xətt', '15 AZN')">Bilet Al - 15 AZN</button>
        </div>
      </div>
      <div class="play-card">
        <div class="card-image" style="background: linear-gradient(to top, rgba(13, 13, 13, 0.9), transparent), url(images/sonzeng.png) center/cover;"></div>
        <div class="card-content">
          <h3>Son Zəng</h3>
          <p>Faciə | 90 dəq</p>
          <button class="outline-btn" onclick="openPopup('Son Zəng', '12 AZN')">Bilet Al - 12 AZN</button>
        </div>
      </div>
      <div class="play-card">
        <div class="card-image" style="background: linear-gradient(to top, rgba(13, 13, 13, 0.9), transparent), url(images/kohnesaat.png) center/cover;"></div>
        <div class="card-content">
          <h3>Köhnə Saat</h3>
          <p>Komediya | 100 dəq</p>
          <button class="outline-btn" onclick="openPopup('Köhnə Saat', '10 AZN')">Bilet Al - 10 AZN</button>
        </div>
      </div>
    </div>
    <div class="text-center" style="margin-top: 3rem">
      <a asp-controller="Repertoire" class="outline-btn" style="text-decoration: none; padding: 1rem 2rem">Bütün Tamaşalara Bax</a>
    </div>
  </section>

  <!-- Fəlsəfə (Geniş) -->
