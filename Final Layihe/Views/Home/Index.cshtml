    <h2 class="section-title">Aparıcı Aktyorlarımız</h2>
    <div class="actors-grid" style="max-width: 1100px; margin: 0 auto">
      <div class="actor-card">
        <div class="actor-img" style="background-image: url(https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=400&q=80);"></div>
        <h4>Emin Qasımlı</h4>
        <p>Baş Aktyor</p>
      </div>
      <div class="actor-card">
        <div class="actor-img" style="background-image: url(https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80);"></div>
        <h4>Leyla Həsənova</h4>
        <p>Baş Aktrisa</p>
      </div>
      <div class="actor-card">
        <div class="actor-img" style="background-image: url(images/badiirehber.png);"></div>
        <h4>Nicat Əliyev</h4>
        <p>Baş Rejissor</p>
      </div>
      <div class="actor-card">
        <div class="actor-img" style="background-image: url(https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=400&q=80);"></div>
        <h4>Samir Mustafayev</h4>
        <p>Aktyor</p>
      </div>
    </div>
  </section>

  <!-- İzləyici rəyləri -->
