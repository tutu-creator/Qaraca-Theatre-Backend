@{
    ViewData["Title"] = "Home Page";
}

<section id="hero" class="hero">
  <div class="hero-content">
    <h1>Səhnənin Qəlbinə Toxun</h1>
    <p>Həyatın əsl üzünü "Qaraca" teatrında kəşf et.</p>
    <a asp-controller="Repertoire" asp-action="Index" class="primary-btn" style="text-decoration: none">
      Repertuarla Tanış Ol
    </a>
  </div>
</section>

<!-- POPUP -->
<div id="popup-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.85); z-index:9999; align-items:flex-start; justify-content:center; overflow-y:auto;">
    <div style="background:#1a1a1a; border-radius:12px; border-top:3px solid #d90429; padding:2rem; max-width:600px; width:90%; margin:2rem auto;">
        <h2 id="popup-name" style="font-family:'Playfair Display',serif; color:#ff9f1c; margin-bottom:0.3rem;"></h2>
        <p id="popup-price" style="color:#ccc; margin-bottom:1.5rem; font-size:1rem;"></p>

        <div style="background:linear-gradient(45deg,#d90429,#ff9f1c); border-radius:6px; text-align:center; padding:0.5rem; color:#fff; font-weight:600; font-size:0.85rem; margin-bottom:1.5rem; letter-spacing:2px;">
            🎭 SƏHNƏ
        </div>

        <div id="seat-map" style="margin-bottom:1rem;"></div>

        <div style="display:flex; gap:1.5rem; margin-bottom:1.5rem; font-size:0.8rem; color:#aaa;">
            <span><span style="display:inline-block; width:14px; height:14px; background:#333; border-radius:3px; margin-right:4px; vertical-align:middle;"></span>Boş</span>
            <span><span style="display:inline-block; width:14px; height:14px; background:#27ae60; border-radius:3px; margin-right:4px; vertical-align:middle;"></span>Seçilmiş</span>
            <span><span style="display:inline-block; width:14px; height:14px; background:#d90429; border-radius:3px; margin-right:4px; vertical-align:middle;"></span>Dolu</span>
        </div>

        <p id="selected-info" style="color:#ff9f1c; font-size:0.9rem; margin-bottom:1.5rem; min-height:20px;"></p>

        <div style="margin-bottom:1rem;">
            <label style="display:block; color:#aaa; font-size:0.85rem; text-transform:uppercase; margin-bottom:6px;">Adınız</label>
            <input type="text" placeholder="Adınızı daxil edin" style="width:100%; padding:10px 14px; background:#111; border:1px solid #333; border-radius:5px; color:#fff; font-size:14px; outline:none;" />
        </div>
        <div style="margin-bottom:1.5rem;">
            <label style="display:block; color:#aaa; font-size:0.85rem; text-transform:uppercase; margin-bottom:6px;">Email</label>
            <input type="email" placeholder="Email daxil edin" style="width:100%; padding:10px 14px; background:#111; border:1px solid #333; border-radius:5px; color:#fff; font-size:14px; outline:none;" />
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center;">
            <button onclick="closePopup()" style="background:transparent; color:#aaa; border:1px solid #444; padding:0.6rem 1.5rem; border-radius:20px; cursor:pointer; font-size:0.85rem;">← Bağla</button>
            <button onclick="confirmTicket()" style="background:linear-gradient(45deg,#d90429,#ff9f1c); color:#fff; border:none; padding:0.6rem 1.8rem; border-radius:20px; cursor:pointer; font-size:0.85rem; font-weight:600;">Təsdiqlə</button>
        </div>
    </div>
</div>

  <!-- Seçilmiş Tamaşalar Preview -->
