      <div class="gallery-item" style="background-image: url(images/qirmizixett.png); border: 1px solid #333;"></div>
      <div class="gallery-item" style="background-image: url(images/badiirehber.png); border: 1px solid #333;"></div>
    </div>
  </section>

  <!-- Aktyorlar -->
